# Platform gateway / contact API URL. Newsletter always uses same-origin
# /api/subscribe, routed to the public API by the shipped nginx configuration.
# Leave empty only when the deployment reverse-proxies those routes on the
# same origin as the static site.
VITE_GATEWAY_URL=https://api.example.com
# Keep public checkout disabled until a production identity provider supplies
# a short-lived owner token to the browser session. Never ask users to paste it.
VITE_PUBLIC_CHECKOUT_ENABLED=false
# Cloudflare Turnstile public site key. Set together with TURNSTILE_SECRET on
# the public API, or leave both empty to disable the challenge.
VITE_TURNSTILE_SITE_KEY=
