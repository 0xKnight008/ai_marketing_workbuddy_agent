FROM nginx:1.27-alpine

# 删除 Nginx 默认配置
RUN rm /etc/nginx/conf.d/default.conf

# 复制自定义 Nginx 配置
COPY nginx.conf /etc/nginx/conf.d/app.conf

# 复制所有构建产物到 Nginx 静态目录
COPY index.html /usr/share/nginx/html/
COPY favicon.png /usr/share/nginx/html/
COPY assets/ /usr/share/nginx/html/assets/
COPY zh/ /usr/share/nginx/html/zh/
COPY en/ /usr/share/nginx/html/en/
COPY es/ /usr/share/nginx/html/es/
COPY for/ /usr/share/nginx/html/for/
COPY contact/ /usr/share/nginx/html/contact/
COPY privacy/ /usr/share/nginx/html/privacy/
COPY terms/ /usr/share/nginx/html/terms/
COPY robots.txt /usr/share/nginx/html/robots.txt
COPY sitemap.xml /usr/share/nginx/html/sitemap.xml

# 验证文件已复制
RUN ls -la /usr/share/nginx/html/ && \
    ls -la /usr/share/nginx/html/assets/ && \
    ls -la /usr/share/nginx/html/zh/ && \
    ls -la /usr/share/nginx/html/en/ && \
    ls -la /usr/share/nginx/html/es/

# 暴露端口
EXPOSE 80

# 启动 Nginx
CMD ["nginx", "-g", "daemon off;"]
