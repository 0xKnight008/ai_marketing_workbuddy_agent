# Newsletter signup is stored in PostgreSQL; Google Forms is no longer used.
NEWSLETTER_TEMPLATE_ID=welcome-email
NEWSLETTER_CTA_URL=https://www.piggybot.me/app
NEWSLETTER_DEFAULT_FIRST_NAME=there
NEWSLETTER_WELCOME_ENABLED=true
DATABASE_URL=postgresql://piggybot:replace-me@127.0.0.1:5432/piggybot?sslmode=require
# Configure both Discord values or leave both empty.
DISCORD_BOT_TOKEN=
DISCORD_FEEDBACK_CHANNEL_ID=
# Required together to relay human Discord thread replies to the customer.
RESEND_API_KEY=
FEEDBACK_FROM_EMAIL="Piggybot Support <support@example.com>"
DISCORD_REPLY_POLL_MS=15000
# The Egg platform also polls. Set false here to run only the platform poller.
# If both run the new version, shared database leases prevent duplicate sends.
DISCORD_REPLY_DELIVERY_ENABLED=true
# Set together with the website's VITE_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET=
