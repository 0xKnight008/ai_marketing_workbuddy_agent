DATABASE_URL=postgres://piggybot:piggybot@localhost:5432/piggybot
# Exactly 32 bytes, base64 encoded. Generate with: openssl rand -base64 32
SECRET_ENCRYPTION_KEY_BASE64=
INTERNAL_SERVICE_TOKEN=replace-me
AUTH_TOKEN_SECRET=replace-with-a-32-byte-or-longer-secret
AI_RUNTIME_EVENT_SIGNING_SECRET=replace-with-the-ai-runtime-event-callback-signing-secret
CORS_ORIGINS=http://localhost:5173
GATEWAY_PORT=4100
# Stripe Checkout: use recurring Price IDs ($19 / $59 / $169) from the same Stripe account.
PUBLIC_SITE_URL=http://localhost:5173
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Required only for controlled manual back-office entitlement changes; never expose it to the browser.
BILLING_ADMIN_TOKEN=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_AGENCY=
STRIPE_TRIAL_DAYS=7
# Stripe's default webhook tolerance is five minutes.
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
AI_RUNTIME_URL=http://localhost:4111
# Maximum claimed jobs handled before the worker yields back to its scheduler.
# Keep this bounded when hosting RunWorker from Egg Schedule.
WORKER_BATCH_SIZE=100
# Optional read-only Zernio contract-test credentials; never use production write scopes.
ZERNIO_BASE_URL=
ZERNIO_ACCESS_TOKEN=
# OAuth is optional for local tests, but required for the connection endpoints.
ZERNIO_OAUTH_CLIENT_ID=
ZERNIO_OAUTH_REDIRECT_URI=http://localhost:4100/api/zernio/callback
ZERNIO_OAUTH_STATE_SECRET=
