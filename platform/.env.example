DATABASE_URL=postgres://piggybot:piggybot@localhost:5432/piggybot
# Required when EGG_SERVER_ENV=prod. Use two or more long random values,
# comma-separated, to support safe cookie-key rotation.
EGG_COOKIE_KEYS=
# Set only when the service is behind a trusted reverse proxy.
TRUST_PROXY=false
# Exactly 32 bytes, base64 encoded. Generate with: openssl rand -base64 32
SECRET_ENCRYPTION_KEY_BASE64=
INTERNAL_SERVICE_TOKEN=replace-me
AUTH_TOKEN_SECRET=replace-with-a-32-byte-or-longer-secret
AI_RUNTIME_EVENT_SIGNING_SECRET=replace-with-the-ai-runtime-event-callback-signing-secret
CORS_ORIGINS=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173
GATEWAY_PORT=4100
# egg-scripts uses this for production startup configuration.
EGG_SERVER_ENV=prod
AI_RUNTIME_URL=http://localhost:4111
# Maximum claimed jobs handled before the worker yields back to its scheduler.
# Keep this bounded when hosting RunWorker from Egg Schedule.
WORKER_BATCH_SIZE=100
WORKER_NAME=run-worker-1
WORKER_IDLE_MS=1000
# One team API key is shared by the gateway and worker. Piggybot isolates each
# workspace with a dedicated Zernio profile and validates account ownership.
ZERNIO_BASE_URL=https://zernio.com/api
ZERNIO_API_KEY=
# Keep this at roughly 80% of the RPM supplied by your active Zernio tier.
# Default: 480 (for a 600 RPM supplier bucket). Raise it after a plan upgrade.
ZERNIO_CLIENT_RPM=480
ZERNIO_OAUTH_REDIRECT_URI=http://localhost:4100/api/zernio/callback
ZERNIO_OAUTH_STATE_SECRET=
# Optional only for the read-only integration contract test.
ZERNIO_PROFILE_ID=

# Stripe billing. Use test values until the complete checkout and webhook flow
# passes. BILLING_ADMIN_TOKEN unlocks private recovery/admin tooling only; use
# at least 32 random characters and never expose it as a VITE_* variable.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_AGENCY=
STRIPE_TRIAL_DAYS=7
STRIPE_PAYMENT_GRACE_DAYS=7
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
BILLING_ADMIN_TOKEN=

# Post-checkout activation delivery. Use a sender on a Resend-verified domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=activation@example.com
ACTIVATION_TICKET_TTL_SECONDS=1800
ACTIVATION_SESSION_TTL_SECONDS=14400

# Email + password console sign-in: lifetime of the issued session token.
AUTH_SESSION_TTL_SECONDS=43200

# Optional feedback notifications. Configure both or neither.
DISCORD_BOT_TOKEN=
DISCORD_FEEDBACK_CHANNEL_ID=
