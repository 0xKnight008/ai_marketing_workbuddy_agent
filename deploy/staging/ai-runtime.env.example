# Piggybot STAGING ai-runtime environment — same-host isolated stack.
# Install at /etc/piggybot-staging/ai-runtime.env (root-readable, never in git).

# ---- LLM ----
# Real-model acceptance requires the same routing proxy as production: proxy
# mode, a proxy-issued key, an OPENAI_BASE_URL ending in /v1, and all six
# primary/fallback aliases (see docs/LLM_ROUTING_PROXY.md). The proxy account
# may be shared with production — acceptance measures real latency/credits —
# but use a separately issued proxy key so staging can be revoked alone.
AI_MODEL_ROUTING_MODE=proxy
AI_MODEL_ECO=
AI_MODEL_STANDARD=
AI_MODEL_FLAGSHIP=
AI_MODEL_ECO_FALLBACK=
AI_MODEL_STANDARD_FALLBACK=
AI_MODEL_FLAGSHIP_FALLBACK=
# OPENAI_BASE_URL=https://llm-router.internal.example/v1
OPENAI_API_KEY=

# ---- Internal API ----
# Shared secret with the STAGING platform only; must match INTERNAL_SERVICE_TOKEN
# in /etc/piggybot-staging/platform.env. Never reuse the production token.
INTERNAL_API_TOKEN=

# ---- Run Service callback ----
# Loopback callback to the STAGING platform port.
RUN_SERVICE_CALLBACK_URL=http://127.0.0.1:4200/internal/ai-runtime-events
# Must exactly match AI_RUNTIME_EVENT_SIGNING_SECRET in the staging platform env.
EVENT_CALLBACK_SIGNING_SECRET=
EVENT_CALLBACK_MAX_RETRIES=3
EVENT_CALLBACK_TIMEOUT_MS=5000

# ---- Server ----
# Staging ai-runtime port — loopback only, never exposed publicly.
PORT=4211
HOST=127.0.0.1

# ---- Storage ----
# Staging-local file storage is acceptable (the deploy directory is isolated);
# switch to a shared LibSQL endpoint only if staging must survive reprovision.
MASTRA_STORAGE_URL=file:./mastra-staging.db
MASTRA_STORAGE_AUTH_TOKEN=
RUN_REGISTRY_RETENTION_MS=86400000
