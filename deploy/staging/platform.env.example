# Piggybot STAGING platform environment — same-host isolated stack.
# Install at /etc/piggybot-staging/platform.env (root-readable, never in git).
# Every value here must be STAGING-SPECIFIC. Never copy production secrets:
# a leaked staging credential must not open production, and vice versa.

# Separate database on the same PostgreSQL instance. deploy-staging.sh refuses
# to run when the URL path does not match STAGING_DB_NAME (default
# piggybot_staging), which keeps this file from ever pointing at production.
DATABASE_URL=postgres://piggybot:STAGING_DB_PASSWORD@127.0.0.1:5432/piggybot_staging

# Required when EGG_SERVER_ENV=prod. Two or more long random values,
# comma-separated, to support safe cookie-key rotation.
EGG_COOKIE_KEYS=
# nginx is the trusted TLS-terminating reverse proxy for staging.piggybot.me.
TRUST_PROXY=true
# Exactly 32 bytes, base64 encoded. Generate with: openssl rand -base64 32
SECRET_ENCRYPTION_KEY_BASE64=
# Generate fresh random values for staging (openssl rand -hex 32); do NOT reuse
# the production tokens.
INTERNAL_SERVICE_TOKEN=
AUTH_TOKEN_SECRET=
AI_RUNTIME_EVENT_SIGNING_SECRET=

CORS_ORIGINS=https://staging.piggybot.me
PUBLIC_SITE_URL=https://staging.piggybot.me
# Staging gateway port — loopback only, never exposed publicly.
GATEWAY_PORT=4200
EGG_SERVER_ENV=prod
# Staging ai-runtime — loopback only.
AI_RUNTIME_URL=http://127.0.0.1:4211

WORKER_BATCH_SIZE=100
WORKER_NAME=staging-run-worker-1
WORKER_IDLE_MS=1000

# Zernio: optional in staging. Leave empty to disable outbound social actions.
# If configured, use a staging Zernio profile and the staging callback:
# ZERNIO_OAUTH_REDIRECT_URI=https://staging.piggybot.me/api/zernio/callback
ZERNIO_BASE_URL=https://zernio.com/api
ZERNIO_API_KEY=
ZERNIO_CLIENT_RPM=480
ZERNIO_OAUTH_REDIRECT_URI=https://staging.piggybot.me/api/zernio/callback
ZERNIO_OAUTH_STATE_SECRET=

# Stripe: TEST-mode keys only. Staging must never create live charges.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_AGENCY=
STRIPE_PRICE_CREATOR_YEARLY=
STRIPE_PRICE_GROWTH_YEARLY=
STRIPE_PRICE_AGENCY_YEARLY=
STRIPE_TRIAL_DAYS=7
STRIPE_PAYMENT_GRACE_DAYS=7
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
BILLING_ADMIN_TOKEN=
PLATFORM_ADMIN_EMAILS=

# Activation + notification email. Optional in staging; leave RESEND_API_KEY
# empty to skip outbound email (notification events stay queued for inspection).
RESEND_API_KEY=
RESEND_FROM_EMAIL=staging-activation@example.com
ACTIVATION_TICKET_TTL_SECONDS=1800
ACTIVATION_SESSION_TTL_SECONDS=14400
AUTH_SESSION_TTL_SECONDS=43200

# Optional feedback notifications. Configure both or neither.
DISCORD_BOT_TOKEN=
DISCORD_FEEDBACK_CHANNEL_ID=
DISCORD_REPLY_DELIVERY_ENABLED=false

# Google Sheets import (Module 1). Optional in staging; when configured, the
# redirect URI must be https://staging.piggybot.me/api/imports/google/callback
# and registered in the Google Cloud console.
# GOOGLE_SHEETS_CLIENT_ID=
# GOOGLE_SHEETS_CLIENT_SECRET=
# GOOGLE_SHEETS_OAUTH_REDIRECT_URI=https://staging.piggybot.me/api/imports/google/callback
# GOOGLE_OAUTH_STATE_SECRET=
