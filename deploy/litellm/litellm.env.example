# Install outside Git at /etc/piggybot/litellm.env, mode 0600.
# Select reviewed database-capable LiteLLM and PostgreSQL 16 images, then pin
# their exact sha256 digests. Empty values intentionally prevent deployment.
LITELLM_IMAGE=
LITELLM_POSTGRES_IMAGE=
LITELLM_ENV_FILE=/etc/piggybot/litellm.env
# Set only after installing the reviewed unified config outside the release tree.
# LITELLM_CONFIG_FILE=/etc/piggybot/litellm-config.yaml
# LITELLM_ROUTING_PROFILE=unified
# DEEPSEEK_API_KEY=
# ZAI_API_KEY=
# Generate once with: openssl rand -hex 32. Keep DB password and salt stable.
LITELLM_DB_PASSWORD=
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
# Actual Flagship upstream credentials, NOT the rejected one-api client key.
# Must match the previously reviewed provider and wire model.
FLAGSHIP_UPSTREAM_MODEL=
FLAGSHIP_UPSTREAM_BASE_URL=
FLAGSHIP_UPSTREAM_API_KEY=

# For the onetoken profile, use scripts/prepare-onetoken-proxy.mjs.
# Add OPUS_UPSTREAM_API_KEY only in the protected server env before preparation.
# The generator moves the existing GPT key to STANDARD_UPSTREAM_API_KEY,
# installs Opus into FLAGSHIP_UPSTREAM_API_KEY, and removes active ZAI_API_KEY.
# Never commit real provider keys. See docs/ONETOKEN_STANDARD_FLAGSHIP_MIGRATION.md.
