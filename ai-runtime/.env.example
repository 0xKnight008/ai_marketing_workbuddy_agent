# ---- LLM ----
# Local development can talk to one provider directly. Production must set this
# to proxy and point OPENAI_BASE_URL at an OpenAI-compatible routing proxy.
AI_MODEL_ROUTING_MODE=direct

# AI SDK model ids. In proxy mode these are router aliases, not upstream model
# names. See ../docs/LLM_ROUTING_PROXY.md for the required six-alias mapping.
AI_MODEL_ECO=openai/gpt-4o-mini
AI_MODEL_STANDARD=openai/gpt-4o
AI_MODEL_FLAGSHIP=openai/o3
AI_MODEL_ECO_FALLBACK=
AI_MODEL_STANDARD_FALLBACK=
AI_MODEL_FLAGSHIP_FALLBACK=

# In proxy mode these are credentials issued by the proxy. Keep the 1token.ai
# and Kimi upstream credentials in the proxy only. The base URL must end in /v1.
# OPENAI_BASE_URL=https://llm-router.internal.example/v1
OPENAI_API_KEY=

# ---- Internal API ----
# Shared secret between run-service and ai-runtime. Required in production.
INTERNAL_API_TOKEN=dev-internal-token

# ---- Run Service callback ----
# The only event callback destination. Per-request callback URLs are intentionally unsupported.
RUN_SERVICE_CALLBACK_URL=http://localhost:4102/internal/ai-runtime-events
# HMAC secret used to sign event callbacks. It must exactly match the gateway's
# AI_RUNTIME_EVENT_SIGNING_SECRET whenever the runtime is connected to it.
EVENT_CALLBACK_SIGNING_SECRET=
# Event delivery retry policy
EVENT_CALLBACK_MAX_RETRIES=3
EVENT_CALLBACK_TIMEOUT_MS=5000

# ---- Server ----
PORT=4111

# ---- Storage ----
# Local development uses file; production must use a shared LibSQL endpoint.
MASTRA_STORAGE_URL=file:./mastra.db
# Required by authenticated remote LibSQL providers such as Turso.
MASTRA_STORAGE_AUTH_TOKEN=
# Retain terminal polling records for 24 hours.
RUN_REGISTRY_RETENTION_MS=86400000
